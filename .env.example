# ---------------------------------------------------------------------------
# LaunchSignal configuration
# Copy this file to .env and fill in the values. .env is git-ignored.
#   cp .env.example .env
# Then check your setup with:  launchsignal doctor
# ---------------------------------------------------------------------------

# Where durable state lives for native runs. Docker Compose overrides this with
# /data/launchsignal.sqlite3, which is backed by the launchsignal-data volume.
LAUNCHSIGNAL_DB_PATH=data/launchsignal.sqlite3

# --- Slack -----------------------------------------------------------------
# Safe default: nothing is sent to Slack while this is true.
# Set to false only after `launchsignal doctor` reports the bot is reachable.
SLACK_DRY_RUN=true

# From Slack API -> your app -> OAuth & Permissions -> Bot User OAuth Token.
# Needs only the chat:write scope. Paste it here; never commit it.
# SLACK_BOT_TOKEN=xoxb-PASTE-YOUR-BOT-TOKEN-HERE

# The destination channel's ID (Channel details -> bottom of the About tab).
# Invite the bot to that channel first: /invite @YourAppName
# SLACK_CHANNEL_ID=C0000000000

# The destination may also be your own user ID (U...) for a direct message
# instead of a channel. A DM additionally needs the im:write bot scope.

# --- Optional: a programme directory whose URL you supply ------------------
# The brief asks for a "YC Speedrun page" but gives no URL, and no such YC
# directory is public (ycombinator.com/speedrun returns 404). a16z Speedrun is
# monitored by default and labelled honestly. If you meant a different page,
# point this at it -- a sitemap, a JSON array, or a JSON API all work.
# LAUNCHSIGNAL_DIRECTORY_URL=
# LAUNCHSIGNAL_DIRECTORY_PROGRAMME=YC Speedrun

# --- Public search (enables the X and LinkedIn sources) --------------------
# Free key from https://tinyfish.ai. Without it the X, LinkedIn and
# official-account sources cannot run, and early claims are reported as
# unverified rather than as beating an official announcement.
# TINYFISH_API_KEY=

# --- Schedule --------------------------------------------------------------
# Full scan cadence in minutes (the task permits every 8 hours = 480).
LAUNCHSIGNAL_INTERVAL_MINUTES=480
# Founder fast lane: a cheap, recency-filtered social sweep between full scans.
# Set to 0 to disable.
LAUNCHSIGNAL_FAST_LANE_MINUTES=45

# --- Tuning ----------------------------------------------------------------
# Batch labels to search for. Update these when a new batch is announced.
LAUNCHSIGNAL_BATCHES=YC S26,YC F26,YC W26,YC X26
# Official accounts used for the "did the programme announce first?" check.
LAUNCHSIGNAL_OFFICIAL_X=ycombinator,a16z,speedrun

# --- Pond Protocol control plane (optional) --------------------------------
# Required before /runs and /tasks will accept any request; they fail closed.
# POND_ACCESS_KEY=
# PORT=8080
